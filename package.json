{
  "name": "reboxed",
  "productName": "Reboxed",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "description": "DJ software for Windows: library, 4 decks, AI stems, controllers.",
  "author": "Vlocky1",
  "license": "MIT",
  "homepage": "https://github.com/Vlocky1/Reboxed#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vlocky1/Reboxed.git"
  },
  "bugs": {
    "url": "https://github.com/Vlocky1/Reboxed/issues"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "shots": "electron . --shots=docs/screenshots",
    "test": "node --test",
    "demo": "node scripts/serve.js",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "music-metadata": "^12.2.1",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.reboxed.app",
    "productName": "Reboxed",
    "copyright": "Copyright (c) 2026 Vlocky1 and the Reboxed contributors (MIT License)",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/onnxruntime-node/bin/napi-v*/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Reboxed"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reboxed",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Reboxed-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
